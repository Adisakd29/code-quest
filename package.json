{
  "name": "code-quest",
  "version": "1.0.0",
  "description": "เกมฝึกเขียนโปรแกรม รัน Python ในเบราว์เซอร์ พร้อมระบบสมาชิกและ EXP",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/run-all.js",
    "test:e2e": "node tests/e2e-security.js",
    "build:icons": "node tools/build-icons.js",
    "test:responsive": "playwright test",
    "qa:responsive": "python3 tests/qa/responsive_audit.py",
    "test:auth": "node tests/e2e-auth.js",
    "test:account": "node tests/e2e-account.js",
    "test:cpp": "node --no-warnings tests/test-cpp.js",
    "test:c2": "node --no-warnings tests/test-c2.js",
    "test:migration": "node tests/e2e-c-migration.js",
    "backup": "node scripts/backup-progress.js backup",
    "backup:verify": "node scripts/backup-progress.js verify"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@yowasp/clang": "^22.0.0-git20542-10",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "google-auth-library": "^11.1.0",
    "jsdom": "^24.1.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "lucide-static": "^1.49.0",
    "simple-icons": "^16.33.0"
  }
}